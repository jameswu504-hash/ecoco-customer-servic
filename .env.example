# Copy this file to .env and fill in the values.

# Runtime mode. Render production should use production.
NODE_ENV=development

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic model. Leave empty to use the server default.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional semantic RAG search. If OPENAI_API_KEY is empty, the app falls back to keyword search.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=80
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BASE_MS=250
EMBEDDING_BACKFILL_LIMIT=1000

# Optional readonly MySQL source for the local IoT sync job.
# Production flow: local machine/VPN -> MySQL -> npm run iot:sync -> PostgreSQL/Neon -> Render bot.
# Render does not need direct MySQL access when the PostgreSQL station table is synced.
# Keep these in environment variables. Do not commit real passwords.
ECOCO_IOT_MYSQL_HOST=
ECOCO_IOT_MYSQL_PORT=3306
ECOCO_IOT_MYSQL_USER=
ECOCO_IOT_MYSQL_PASSWORD=
ECOCO_IOT_MYSQL_DATABASE=
ECOCO_IOT_MYSQL_SSL=true
ECOCO_IOT_MYSQL_SSL_REJECT_UNAUTHORIZED=true
ECOCO_IOT_MYSQL_CONNECTION_LIMIT=4
ECOCO_IOT_MYSQL_CONNECT_TIMEOUT_MS=10000
ECOCO_IOT_STATION_SNAPSHOT_PATH=
# Optional snapshot export destination used by npm run iot:export-snapshot.
IOT_STATION_SNAPSHOT_OUTPUT=
# Optional MCP JSON source for readonly MySQL credentials.
MCP_CONFIG_PATH=
ECOCO_IOT_SYNC_URL=
IOT_SYNC_KEY=
# Compatibility aliases used by older local sync runners. Prefer IOT_SYNC_KEY.
ECOCO_IOT_SYNC_KEY=
ECOCO_IOT_SYNC_ADMIN_KEY=
IOT_SYNC_RATE_LIMIT_MAX=120
STATION_DATA_MAX_AGE_MS=1800000

# Optional answer-quality evals.
# ECOCO_BASE_URL and ADMIN_KEY are usually stored in GitHub Actions secrets, not Render.
ECOCO_BASE_URL=
EVAL_GOLDEN_SET=evals/golden-set.json
EVAL_TIMEOUT_MS=45000
EVAL_MIN_PASS_RATE=0.85
EVAL_JUDGE_MODEL=
SYNONYM_SUGGEST_MODEL=

# Optional maintenance scripts and GitHub Actions.
BACKUP_DIR=backups
KNOWLEDGE_IMPORT_PATH=data/ecoco-knowledge-import.json
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO=

# LINE Official Account Messaging API.
# Keep empty until the company provides LINE Developers credentials.
# Webhook URL: https://<render-domain>/api/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_RATE_LIMIT_MAX_EVENTS=8
LINE_REPLY_TIMEOUT_MS=25000
LINE_TIMEOUT_REPLY=目前正在查詢資料，若問題需要人工確認，客服會再協助處理。

# PostgreSQL connection string, for example Neon / Supabase / Render Postgres.
DATABASE_URL=postgresql://user:password@host:5432/database

# Cloud Postgres usually needs SSL.
# require: encrypted connection without certificate verification.
# verify-full: encrypted connection with certificate verification when the provider CA chain is trusted.
# disable: only for trusted local development.
PGSSL=verify-full

# Admin dashboard login key.
ADMIN_KEY=your-admin-key-here
ADMIN_RATE_LIMIT_MAX=30

# Signs browser sessions. Use a separate random value of at least 32 characters.
SESSION_SECRET=your-random-session-secret-here
WEB_CHAT_TIMEOUT_MS=45000

# Service mode.
# customer: public customer-service website and dashboard.
# internal: enables /api/internal for staff wiki / training knowledge.
APP_MODE=customer
STAFF_KEY=

# Optional data retention. Suggested production value: 90 or 180.
# Aggregated reports still remain useful after old raw logs are removed.
CONVERSATION_RETENTION_DAYS=180

# Sync data/ecoco-knowledge-import.json into PostgreSQL when the server starts.
# disable: daily maintenance uses the dashboard/PostgreSQL only.
# insert_only: insert missing categories without overwriting dashboard edits.
# upsert: update matching categories and insert new ones.
# replace: delete existing knowledge_sections and re-import from JSON.
KNOWLEDGE_AUTO_SYNC=disable

# Optional. Set to always only when you intentionally want to rebuild all RAG chunks on startup.
# Normal production use should leave this empty.
REBUILD_KNOWLEDGE_CHUNKS_ON_START=

# Server port.
PORT=3000
